import pygame

def main():
    pygame.init()
    display = pygame.display.set_mode()
    width = display.get_width()
    height = display.get_height()
    cell_width = width // 8
    cell_height = height // 8
    black = False

    for row in range(8):
        for col in range(8):
            cell = pygame.Surface((cell_width, cell_height))
            display.blit(cell, (col * cell_height, row + cell_width))
            if black: cell.fill((0,0,0))
            else: cell.fill((255, 255, 255))
            black = not black

    while True:
        pass



if __name__ == "__main__":
    main()